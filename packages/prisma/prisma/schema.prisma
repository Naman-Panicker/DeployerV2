datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  projects     Project[]

  @@map("users")
}

model Project {
  id                  String       @id @default(uuid())
  userId              String       @map("user_id")
  name                String
  repoUrl             String       @map("repo_url")
  branch              String       @default("main")
  subdomain           String       @unique
  currentDeploymentId String?      @map("current_deployment_id")
  envVarsEncrypted    Json?        @map("env_vars_encrypted")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments         Deployment[] @relation("ProjectDeployments")

  @@map("projects")
}

model Deployment {
  id           String           @id @default(uuid())
  projectId    String           @map("project_id")
  status       DeploymentStatus @default(QUEUED)
  commitHash   String?          @map("commit_hash")
  triggerType  TriggerType      @default(MANUAL) @map("trigger_type")
  s3Prefix     String?          @map("s3_prefix")
  failureType    FailureType?   @map("failure_type")
  failureMessage String?        @map("failure_message") // user-facing reason, safe to show in the UI
  startedAt    DateTime?        @map("started_at")
  completedAt  DateTime?        @map("completed_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  project      Project          @relation("ProjectDeployments", fields: [projectId], references: [id], onDelete: Cascade)
  logs         DeploymentLog[]
  failures     DeploymentFailure[]

  @@map("deployments")
}

// Internal maintenance record for every failed deployment. Never exposed to users.
model DeploymentFailure {
  id           String      @id @default(uuid())
  deploymentId String      @map("deployment_id")
  type         FailureType
  stage        String      // queue | setup | clone | detect | install | build | upload | finalize | shutdown | recovery
  exitCode     Int?        @map("exit_code")
  details      String      // error message, stack trace and last container log lines
  createdAt    DateTime    @default(now()) @map("created_at")

  deployment   Deployment  @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@map("deployment_failures")
}

model DeploymentLog {
  id           BigInt     @id @default(autoincrement())
  deploymentId String     @map("deployment_id")
  stream       String     // "stdout" | "stderr"
  line         String
  timestamp    DateTime   @default(now())

  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, id])
  @@map("deployment_logs")
}

enum DeploymentStatus {
  QUEUED
  CLONING
  BUILDING
  UPLOADING
  DEPLOYED
  FAILED
}

enum FailureType {
  BUILD_ERROR  // caused by the repository: clone, install or build failed, timeout, out of memory
  SYSTEM_ERROR // caused by our infrastructure: queue, Docker, S3, database, build server crash
}

enum TriggerType {
  MANUAL
  WEBHOOK
  ROLLBACK
}

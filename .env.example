# ==============================================================================
# Deployer - Environment Configuration Template
# Copy this file to .env and fill in required values
# ==============================================================================

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=deployer_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/deployer_db

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=deployer-artifacts

# Authentication (HS256 secret)
JWT_SECRET=deployer-dev-secret-change-in-prod-32-chars-long

# Encryption Key (32-byte / 64-hex string for AES-256)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Service Ports
API_GATEWAY_PORT=9000
BUILD_SERVER_PORT=9001
UPLOAD_SERVICE_PORT=9002
LOG_SERVICE_PORT=9003
REVERSE_PROXY_PORT=8080

# ==============================================================================
# Deployer - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.

# PostgreSQL Database (matches docker-compose.yml defaults)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=deployer_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/deployer_db

# Redis (password required; docker-compose refuses to start without REDIS_PASSWORD)
# Use letters and digits only (e.g. `openssl rand -hex 32`) so it can sit in the URL unescaped,
# and keep REDIS_URL's password in sync with REDIS_PASSWORD.
REDIS_PASSWORD=change-me-to-a-long-random-hex-string
REDIS_URL=redis://:change-me-to-a-long-random-hex-string@localhost:6379

# AWS S3 Configuration (required for build artifact upload and serving)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=deployer-artifacts

# Authentication (HMAC-SHA256 JWT signing secret, minimum 32 characters)
JWT_SECRET=deployer-dev-secret-change-in-prod-32-chars-long

# Encryption Key (AES-256-GCM for environment variables, exactly 64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Service Ports & Hosts
API_GATEWAY_PORT=9000
LOG_SERVICE_PORT=9003
LOG_SERVICE_URL=http://localhost:9003
REVERSE_PROXY_PORT=8080

# GitHub Webhook (optional for local testing; set when verifying HMAC signatures)
GITHUB_WEBHOOK_SECRET=
